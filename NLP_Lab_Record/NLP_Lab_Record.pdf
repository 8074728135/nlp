%PreformattedPara
0 0 0 rg
BT 1 0 0 1 6 151.5 Tm /F2 9.5 Tf 11.5 TL (# pip install spacy && python -m spacy download en_core_web_sm) Tj T* (import spacy) Tj T*  T* (nlp = spacy.load\("en_core_web_sm"\)) Tj T*  T* (text = \("Apple is looking at buying a U.K. startup for $1 billion. ") Tj T* (        "Sundar Pichai met Narendra Modi in New Delhi on 15 March 2024."\)) Tj T*  T* (doc = nlp\(text\)) Tj T*  T* (print\(f"{'Entity':22}{'Label':10}{'Meaning'}"\)) Tj T* (print\("-" * 60\)) Tj T* (for ent in doc.ents:) Tj T* (    print\(f"{ent.text:22}{ent.label_:10}{spacy.explain\(ent.label_\)}"\)) Tj T* ET
Q
