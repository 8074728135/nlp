%PreformattedPara
0 0 0 rg
BT 1 0 0 1 6 186 Tm /F2 9.5 Tf 11.5 TL (import nltk) Tj T* (from nltk.tokenize import word_tokenize) Tj T*  T* (nltk.download\("punkt"\)) Tj T* (nltk.download\("punkt_tab"\)) Tj T* (nltk.download\("averaged_perceptron_tagger"\)) Tj T* (nltk.download\("averaged_perceptron_tagger_eng"\)) Tj T*  T* (text = "The quick brown fox jumps over the lazy dog near the river bank.") Tj T* (tokens = word_tokenize\(text\)) Tj T* (tagged = nltk.pos_tag\(tokens\)) Tj T*  T* (print\("Tokens :", tokens\)) Tj T* (print\(\)) Tj T* (print\(f"{'Word':10}{'Tag'}"\)) Tj T* (for word, tag in tagged:) Tj T* (    print\(f"{word:10}{tag}"\)) Tj T* ET
Q
