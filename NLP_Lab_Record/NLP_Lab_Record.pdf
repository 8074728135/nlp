%PreformattedPara
0 0 0 rg
BT 1 0 0 1 6 220.5 Tm /F2 9.5 Tf 11.5 TL (import nltk) Tj T* (from nltk.corpus import wordnet as wn) Tj T*  T* (nltk.download\("wordnet"\)) Tj T* (nltk.download\("omw-1.4"\)) Tj T*  T* (word = "bank") Tj T* (print\(f"Synsets of '{word}': {len\(wn.synsets\(word\)\)}\\n"\)) Tj T* (for s in wn.synsets\(word\)[:5]:) Tj T* (    print\(s.name\(\), "|", s.pos\(\), "|", s.definition\(\)\)) Tj T* (    print\("    lemmas   :", s.lemma_names\(\)\)) Tj T* (    print\("    examples :", s.examples\(\)[:1]\)) Tj T*  T* (dog = wn.synset\("dog.n.01"\)) Tj T* (print\("\\nHypernyms of dog.n.01 :", dog.hypernyms\(\)\)) Tj T* (print\("Hyponyms \(first 3\)    :", dog.hyponyms\(\)[:3]\)) Tj T*  T* (good = wn.synsets\("good", pos=wn.ADJ\)[0]) Tj T* (print\("Antonyms of good      :", [a.name\(\) for l in good.lemmas\(\) for a in l.antonyms\(\)]\)) Tj T* (print\("Similarity dog~cat    :", dog.path_similarity\(wn.synset\("cat.n.01"\)\)\)) Tj T* ET
Q
