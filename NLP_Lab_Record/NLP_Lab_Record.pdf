%PreformattedPara
0 0 0 rg
BT 1 0 0 1 6 220.5 Tm /F2 9.5 Tf 11.5 TL (import nltk) Tj T* (from nltk.stem import WordNetLemmatizer, PorterStemmer, LancasterStemmer) Tj T* (from nltk.tokenize import word_tokenize) Tj T*  T* (nltk.download\("punkt"\)) Tj T* (nltk.download\("punkt_tab"\)) Tj T* (nltk.download\("wordnet"\)) Tj T* (nltk.download\("omw-1.4"\)) Tj T*  T* (text = "The children were running quickly and the geese are flying higher") Tj T* (tokens = word_tokenize\(text\)) Tj T*  T* (lemmatizer = WordNetLemmatizer\(\)) Tj T* (porter = PorterStemmer\(\)) Tj T* (lancaster = LancasterStemmer\(\)) Tj T*  T* (print\(f"{'Word':12}{'Porter':12}{'Lancaster':12}{'Lemma\(noun\)':14}{'Lemma\(verb\)':12}"\)) Tj T* (for w in tokens:) Tj T* (    print\(f"{w:12}{porter.stem\(w\):12}{lancaster.stem\(w\):12}") Tj T* (          f"{lemmatizer.lemmatize\(w, 'n'\):14}{lemmatizer.lemmatize\(w, 'v'\):12}"\)) Tj T* ET
Q
